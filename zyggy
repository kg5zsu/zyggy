    def input_dialog(self, title, text, default=""):
        dialog = Gtk.MessageDialog(parent=self.window, title=title,
                                   message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.OK_CANCEL,
                                   text=text)
        entry = Gtk.Entry()
        entry.set_text(default)
        entry.set_activates_default(True)
        dialog.set_border_width(8)
        dialog.vbox.pack_start(entry, False, False, 6)
        dialog.show_all()
        res = dialog.run()
        value = entry.get_text().strip()
        dialog.destroy()
        if res == Gtk.ResponseType.OK and value:
            return value
        return None

    def confirm_dialog(self, title, text):
        dialog = Gtk.MessageDialog(parent=self.window, title=title,
                                   message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.YES_NO,
                                   text=text)
        dialog.set_border_width(8)
        dialog.show_all()
        res = dialog.run()
        dialog.destroy()
        return res == Gtk.ResponseType.YES

