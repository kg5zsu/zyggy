    def refresh(self):
        self.pool_combo.remove_all()
        self.import_btn.hide()
        out, err, rc = run_cmd(["zpool", "list", "-H", "-o", "name"])
        pools = out.splitlines() if rc == 0 else []
        for p in pools:
            self.pool_combo.append_text(p)
        if pools:
            self.pool_combo.set_active(0)
        else:
            self.pool_combo.append_text("-- no pools imported --")
            self.pool_combo.set_active(0)
            self.import_pool_names = []
            import_out, import_err, import_rc = run_cmd(["zpool", "import"])
            if import_rc == 0 and import_out.strip():
                for line in import_out.splitlines():
                    m = re.search(r'^\s*pool:\s+(.+)$', line)
                    if m:
                        self.import_pool_names.append(m.group(1).strip())
                if self.import_pool_names:
                    names = ", ".join(self.import_pool_names)
                    msg = f"Unimported pools: {names}"
                    self.import_btn.show()
                else:
                    msg = "No ZFS pools found."
            elif import_rc != 0 and ("permission denied" in import_err or "not authorized" in import_err):
                msg = "Permission denied. Run with: pkexec ./zyggy"
            else:
                msg = "No ZFS pools found."
            for text_view in (self.status_text, self.scrub_text, self.io_text):
                text_view.get_buffer().set_text(msg)
            self.smart_text.get_buffer().set_text("No pool selected.")
            return
        self.update_status()
        self.update_scrub()
        self.update_smart()
        self.update_iostat()

    def import_pool(self):
        names = getattr(self, "import_pool_names", [])
        if not names:
            self.app.message_dialog("No unimported pools found.")
            return
        choices = "\n".join(f"{i+1}. {n}" for i, n in enumerate(names))
        idx = self.app.input_dialog("Import Pool", f"Enter pool name to import:\n{choices}", names[0])
        if idx and idx in names:
            self.app.run_zfs_cmd(["zpool", "import", idx])
            self.refresh()
        elif idx:
            self.app.run_zfs_cmd(["zpool", "import", idx])
            self.refresh()

    def get_pool(self):
        return self.pool_combo.get_active_text()

    def run_action(self, action):
        pool = self.get_pool()
        if not pool or pool.startswith("--"):
            self.app.error_dialog("Select a pool first.")
            return
        if action == "scrub":
            if self.app.confirm_dialog("Scrub", f"Start scrub on {pool}?"):
                self.app.run_zfs_cmd(["zpool", "scrub", pool])
                self.refresh()
        elif action == "status":
            out, err, rc = run_cmd(["zpool", "status", "-v", pool])
            buf = self.status_text.get_buffer()
            buf.set_text(out if rc == 0 else err)
            self.notebook.set_current_page(0)
        elif action == "iostat":
            def io_thread():
                out, err, rc = run_cmd(["zpool", "iostat", "-v", pool])
                GLib.idle_add(self._set_io_text, out if rc == 0 else err)
            Thread(target=io_thread, daemon=True).start()
        elif action == "smart":
            self.update_smart(force=True)

    def _set_io_text(self, text):
        buf = self.io_text.get_buffer()
        buf.set_text(text)
        self.notebook.set_current_page(3)

    def update_status(self):
        pool = self.get_pool()
        if not pool:
            return
        out, err, rc = run_cmd(["zpool", "status", pool])
        buf = self.status_text.get_buffer()
        buf.set_text(out if rc == 0 else err)

    def update_scrub(self):
        pool = self.get_pool()
        if not pool:
            return
        out, err, rc = run_cmd(["zpool", "status", pool])
        text = "No scrub information available."
        if rc == 0:
            for line in out.splitlines():
                if "scan:" in line:
                    text = line.strip()
                    break
            if "scrub repaired" in out or "scrub in progress" in out:
                text = out
        buf = self.scrub_text.get_buffer()
        buf.set_text(text)

    def update_smart(self, force=False):
        pool = self.get_pool()
        if not pool:
            return
        has_smart = run_cmd(["which", "smartctl"])[1] == ""
        if not has_smart:
            buf = self.smart_text.get_buffer()
            buf.set_text("smartctl not found. Install smartmontools:\n"
                         "  Ubuntu/Debian: sudo apt install smartmontools\n"
                         "  RHEL/Fedora:   sudo dnf install smartmontools")
            return
        disks = get_pool_disks(pool)
        if not disks:
            buf = self.smart_text.get_buffer()
            buf.set_text("No pool member disks found.")
            return
        def smart_thread():
            results = []
            for d in disks:
                for flag in ["", "-d auto", "-d sat", "-d usbjmicron", "-d scsi"]:
                    cmd = ["smartctl"] + (flag.split() if flag else []) + ["-a", f"/dev/{d}"]
                    out, err, rc = run_cmd(cmd)
                    combined = out + "\n" + err
                    if rc == 0 or "SMART" in combined or "Device Model" in combined:
                        info = {}
                        for line in combined.splitlines():
                            if "Device Model:" in line:
                                info["Model"] = line.split(":", 1)[1].strip()
                            if "Serial Number:" in line:
                                info["Serial"] = line.split(":", 1)[1].strip()
                            if "Firmware Version:" in line:
                                info["Firmware"] = line.split(":", 1)[1].strip()
                            if "overall-health" in line:
                                info["Health"] = line.split()[-1]
                        for attr, label in [
                            ("Power_On_Hours", "Power-On Hours"),
                            ("Temperature_Celsius", "Temperature"),
                            ("Reallocated_Sector_Ct", "Reallocated Sectors"),
                            ("Current_Pending_Sector", "Pending Sectors"),
                            ("Offline_Uncorrectable", "Offline Uncorrectable"),
                            ("UDMA_CRC_Error_Count", "UDMA CRC Errors"),
                            ("Raw_Read_Error_Rate", "Read Error Rate"),
                            ("Spin_Up_Time", "Spin-Up Time"),
                            ("Power_Cycle_Count", "Power Cycles"),
                            ("Start_Stop_Count", "Start/Stop Count"),
                            ("Load_Cycle_Count", "Load Cycles"),
                            ("Reported_Uncorrect", "Reported Uncorrect"),
                            ("Command_Timeout", "Command Timeout"),
                            ("Reallocated_Event_Count", "Reallocated Events"),
                            ("Spin_Retry_Count", "Spin Retries"),
                        ]:
                            for line in combined.splitlines():
                                if attr in line:
                                    parts = line.split()
                                    if len(parts) >= 10:
                                        raw = parts[9]
                                        if attr == "Power_On_Hours":
                                            raw = raw.rstrip("h")
                                        info[label] = raw
                                    break
                        results.append(f"/dev/{d}")
                        if "Model" in info:
                            results.append(f"  {info['Model']}")
                        if "Serial" in info:
                            results.append(f"  S/N: {info['Serial']}")
                        if "Health" in info:
                            h = info["Health"]
                            icon = "✓" if h == "PASSED" else "✗"
                            results.append(f"  Health: {h} {icon}")
                        for label in ["Temperature", "Power-On Hours", "Power Cycles",
                                      "Reallocated Sectors", "Pending Sectors",
                                      "Offline Uncorrectable", "UDMA CRC Errors",
                                      "Start/Stop Count", "Load Cycles",
                                      "Read Error Rate", "Spin-Up Time",
                                      "Spin Retries", "Reported Uncorrect",
                                      "Command Timeout", "Reallocated Events"]:
                            if label in info:
                                results.append(f"  {label}: {info[label]}")
                        if flag:
                            results.append(f"  (smartctl flag: {flag})")
                        results.append("")
                        break
                else:
                    results.append(f"/dev/{d}: SMART not supported")
                    results.append("")
            GLib.idle_add(self._set_smart_text, "\n".join(results))
        Thread(target=smart_thread, daemon=True).start()

    def _set_smart_text(self, text):
        buf = self.smart_text.get_buffer()
        buf.set_text(text)
        self.notebook.set_current_page(2)

    def update_iostat(self):
        pool = self.get_pool()
        if not pool:
            return
        def io_thread():
            out, err, rc = run_cmd(["zpool", "iostat", "-v", pool])
            GLib.idle_add(self._set_io_text, out if rc == 0 else err)
        Thread(target=io_thread, daemon=True).start()


class ZyggyApp:
    def __init__(self):
        self.window = Gtk.Window()
        self.window.set_title("Zyggy - ZFS Administration")
        self.window.set_default_size(1000, 650)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.connect("destroy", Gtk.main_quit)

        self.pages = {}
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)

        for i, label in enumerate(MODE_LABELS):
            if i == HEALTH:
                page = HealthPage(self)
            else:
                page = ModePage(self, i)
            self.pages[i] = page
            self.stack.add_titled(page.widget, label.lower(), label)

        sidebar = Gtk.StackSidebar()
        sidebar.set_stack(self.stack)
        sidebar.set_size_request(160, -1)
        self.stack.connect("notify::visible-child", self.on_mode_switched)

        paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        paned.pack1(sidebar, False, False)
        paned.pack2(self.stack, True, False)

        self.window.add(paned)
        self.window.show_all()
        self.current_mode = DATASETS
        self.update_current_page()

    def on_mode_switched(self, stack, pspec):
        child = stack.get_visible_child()
        for mode, page in self.pages.items():
            if page.widget == child:
                self.current_mode = mode
                self.update_current_page()
                break

    def update_current_page(self):
        if self.current_mode == HEALTH:
            self.pages[HEALTH].refresh()
        else:
            self.build_toolbar()
            self.refresh_list()

    def build_toolbar(self):
        if self.current_mode == HEALTH:
            return
        page = self.pages[self.current_mode]
        box = page.toolbar_box
        for w in box.get_children():
            box.remove(w)

        actions = self.get_actions_for_mode()
        for action_id, icon, tooltip in actions:
            btn = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.MENU)
            btn.set_tooltip_text(tooltip)
            btn.set_name(action_id)
            btn.connect("clicked", lambda b, a=action_id: self.handle_action(a))
            box.pack_start(btn, False, False, 0)

        box.pack_end(self.build_mode_actions(), False, False, 0)

        refresh_btn = Gtk.Button.new_from_icon_name("view-refresh", Gtk.IconSize.MENU)
        refresh_btn.set_tooltip_text("Refresh")
        refresh_btn.connect("clicked", lambda b: self.refresh_list())
        box.pack_end(refresh_btn, False, False, 0)

        box.show_all()

    def build_mode_actions(self):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
        help_btn = Gtk.Button.new_from_icon_name("help-contents", Gtk.IconSize.MENU)
        help_btn.set_tooltip_text("Help")
        help_btn.connect("clicked", lambda b: self.show_help())
        box.pack_start(help_btn, False, False, 0)
        about_btn = Gtk.Button.new_from_icon_name("help-about", Gtk.IconSize.MENU)
        about_btn.set_tooltip_text("About")
        about_btn.connect("clicked", lambda b: self.show_about())
        box.pack_start(about_btn, False, False, 0)
        return box

    def get_actions_for_mode(self):
        common = [("refresh", "view-refresh", "Refresh")]
        if self.current_mode == DATASETS:
            return [
                ("create", "document-new", "Create Dataset"),
                ("snapshot", "camera-photo", "Create Snapshot"),
                ("rename", "document-edit", "Rename"),
                ("clone", "edit-copy", "Clone"),
                ("promote", "go-up", "Promote"),
                ("rollback", "edit-undo", "Rollback"),
                ("delete", "edit-delete", "Destroy"),
                ("properties", "document-properties", "Properties"),
            ]
        elif self.current_mode == SNAPSHOTS:
            return [
                ("rename", "document-edit", "Rename"),
                ("clone", "edit-copy", "Clone"),
                ("rollback", "edit-undo", "Rollback"),
                ("delete", "edit-delete", "Destroy"),
                ("properties", "document-properties", "Properties"),
            ]
        elif self.current_mode == VOLUMES:
            return [
                ("create", "document-new", "Create Volume"),
                ("snapshot", "camera-photo", "Create Snapshot"),
                ("rename", "document-edit", "Rename"),
                ("clone", "edit-copy", "Clone"),
                ("promote", "go-up", "Promote"),
                ("delete", "edit-delete", "Destroy"),
                ("properties", "document-properties", "Properties"),
            ]
