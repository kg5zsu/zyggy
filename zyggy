    def show_properties_dialog(self, text, title, target, is_pool):
        lines = text.splitlines()
        if len(lines) < 2:
            self.message_dialog("No properties found.")
            return

        rows = []
        for line in lines[1:]:
            parts = re.split(r'\s{2,}', line)
            if len(parts) >= 4:
                rows.append([parts[1].strip(), parts[2].strip(), parts[3].strip()])

        store = Gtk.ListStore(str, str, str)
        for r in rows:
            store.append(r)

        tv = Gtk.TreeView(model=store)

        prop_renderer = Gtk.CellRendererText()
        prop_col = Gtk.TreeViewColumn("PROPERTY", prop_renderer, text=0)
        prop_col.set_resizable(True)
        tv.append_column(prop_col)

        toggle_renderer = Gtk.CellRendererToggle()
        toggle_renderer.connect("toggled", self.on_prop_toggled, store, target, is_pool)

        combo_renderer = Gtk.CellRendererCombo()
        combo_renderer.set_property("text-column", 0)
        combo_renderer.set_property("editable", True)
        combo_renderer.connect("edited", self.on_property_edited, store, target, is_pool)

        text_renderer = Gtk.CellRendererText()
        text_renderer.connect("edited", self.on_property_edited, store, target, is_pool)

        def toggle_visible(col, r, model, it, ud):
            visible = model[it][2] != "-" and model[it][0] in BOOLEAN_PROPS
            r.set_property("visible", visible)
            if visible:
                r.set_active(model[it][1] == "on")

        def combo_visible(col, r, model, it, ud):
            prop = model[it][0]
            visible = model[it][2] != "-" and prop in OPTIONS_MODELS and prop not in BOOLEAN_PROPS
            r.set_property("visible", visible)
            if visible:
                r.set_property("model", OPTIONS_MODELS[prop])
                r.set_property("text", model[it][1])
                r.set_property("has-entry", prop in FREE_FORM_COMBO)

        def text_data_func(col, r, model, it, ud):
            prop = model[it][0]
            is_readonly = model[it][2] == "-"
            use_text = prop not in BOOLEAN_PROPS and prop not in OPTIONS_MODELS
            r.set_property("visible", use_text)
            if use_text:
                r.set_property("text", model[it][1])
                r.set_property("editable", not is_readonly)

        val_col = Gtk.TreeViewColumn("VALUE")
        val_col.pack_start(toggle_renderer, False)
        val_col.pack_start(combo_renderer, True)
        val_col.pack_start(text_renderer, True)
        val_col.set_cell_data_func(toggle_renderer, toggle_visible, None)
        val_col.set_cell_data_func(combo_renderer, combo_visible, None)
        val_col.set_cell_data_func(text_renderer, text_data_func, None)
        val_col.set_resizable(True)
        val_col.set_expand(True)
        tv.append_column(val_col)

        src_renderer = Gtk.CellRendererText()
        src_col = Gtk.TreeViewColumn("SOURCE", src_renderer, text=2)
        src_col.set_resizable(True)
        tv.append_column(src_col)

        sw = Gtk.ScrolledWindow()
        sw.set_vexpand(True)
        sw.add(tv)

        close_btn = Gtk.Button(label="Close")
        close_btn.connect("clicked", lambda b: win.destroy())

        help_btn = Gtk.Button.new_from_icon_name("help-contents", Gtk.IconSize.MENU)
        help_btn.set_tooltip_text("Property reference")
        help_btn.connect("clicked", lambda b: self.show_property_help())

        info_label = Gtk.Label()
        info_label.set_markup('<span font_size="small">Toggle booleans with checkbox · Choose options from dropdown · Type free-form values</span>')

        btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        btn_box.pack_start(help_btn, False, False, 0)
        btn_box.pack_start(info_label, False, False, 6)
        btn_box.pack_end(close_btn, False, False, 0)

        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        main.pack_start(sw, True, True, 0)
