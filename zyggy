ZFS_LIST_COLS = {
    DATASETS: ["name", "used", "avail", "refer", "mountpoint", "compression"],
    SNAPSHOTS: ["name", "used", "refer", "creation"],
    VOLUMES: ["name", "used", "avail", "volsize", "origin", "compression"],
