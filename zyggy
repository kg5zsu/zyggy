    def handle_action(self, action_id):
        handler = getattr(self, f"do_{action_id}", None)
        if handler:
            handler()

    def on_selection_changed(self):
        self.update_button_sensitivity()

    def get_target(self):
        if self.current_mode == HEALTH:
            return self.pages[HEALTH].get_pool()
        return self.pages[self.current_mode].get_selected()

    def run_zfs_cmd(self, cmd):
        out, err, rc = run_cmd(cmd)
        if rc != 0:
            self.error_dialog(f"Command failed:\n{' '.join(cmd)}\n\n{err}")
            return False
        self.refresh_list()
        return True

    def refresh_list(self):
        if self.current_mode == HEALTH:
            return
        mode = self.current_mode
        page = self.pages[mode]
        rows, columns = get_zfs_list(mode)
        if rows is None:
            self.error_dialog(columns)
            return
        page.set_columns(columns)
        page.populate(rows)
        self.update_button_sensitivity()

    def update_button_sensitivity(self):
        if self.current_mode == HEALTH:
            return
        has_selection = self.get_target() is not None
        page = self.pages[self.current_mode]
        for w in page.toolbar_box.get_children():
            if not isinstance(w, Gtk.Button):
                continue
            aid = w.get_name() or ""
            always = ("refresh", "create", "create_pool", "import_pool", "zpool_label")
            needs_selection = ("delete", "rename", "properties",
                               "scrub", "status", "upgrade", "export_pool")
            if aid in always:
                w.set_sensitive(True)
            elif aid == "snapshot":
                w.set_sensitive(has_selection and self.current_mode in (DATASETS, VOLUMES))
            elif aid == "clone":
                w.set_sensitive(has_selection and self.current_mode == SNAPSHOTS)
            elif aid == "rollback":
                w.set_sensitive(has_selection and self.current_mode == SNAPSHOTS)
            elif aid == "promote":
                w.set_sensitive(has_selection and self.current_mode in (DATASETS, VOLUMES))
            elif aid in needs_selection:
                w.set_sensitive(has_selection)
            else:
                w.set_sensitive(True)

    # --- Action Handlers ---

    def do_create(self):
        target = self.get_target()
        prefix = f"{target}/" if target else ""
        name = self.input_dialog("Create Dataset", f"Enter dataset name", prefix)
        if name:
            name = name.rstrip("/")
            self.run_zfs_cmd(["zfs", "create", name])

    def do_snapshot(self):
        target = self.get_target()
        if not target:
            return
        name = self.input_dialog("Create Snapshot", f"Snapshot name for {target}", f"{target}@")
        if name:
            name = name.rstrip("@")
            self.run_zfs_cmd(["zfs", "snapshot", name])

    def do_rename(self):
        target = self.get_target()
        if not target:
            return
        if self.current_mode == POOLS:
            name = self.input_dialog("Rename Pool", f"New name for pool {target}", target)
            if name:
                self.run_zfs_cmd(["zpool", "rename", target, name])
        else:
            name = self.input_dialog("Rename", f"New name for {target}", target)
            if name:
                self.run_zfs_cmd(["zfs", "rename", target, name])

    def do_clone(self):
        target = self.get_target()
        if not target or self.current_mode != SNAPSHOTS:
            return
        name = self.input_dialog("Clone Snapshot", f"New dataset name for clone of {target}", target.split('@')[0] + "/clone")
        if name:
            self.run_zfs_cmd(["zfs", "clone", target, name])

    def do_rollback(self):
        target = self.get_target()
        if not target or self.current_mode != SNAPSHOTS:
            return
        if self.confirm_dialog("Rollback", f"Roll back to {target}? This will destroy intermediate snapshots."):
            self.run_zfs_cmd(["zfs", "rollback", "-r", target])

    def do_promote(self):
        target = self.get_target()
        if not target or self.current_mode not in (DATASETS, VOLUMES):
            return
        if self.confirm_dialog("Promote", f"Promote {target}?"):
            self.run_zfs_cmd(["zfs", "promote", target])

    def do_delete(self):
        target = self.get_target()
        if not target:
            return
        if self.current_mode == POOLS:
            msg = f"Destroy pool {target}? This will destroy all data on the pool."
        else:
            msg = f"Destroy {target}? This will destroy the dataset and all snapshots."
        if self.confirm_dialog("Destroy", msg):
            if self.current_mode == POOLS:
                self.run_zfs_cmd(["zpool", "destroy", target])
            else:
                self.run_zfs_cmd(["zfs", "destroy", "-r", target])

    def do_properties(self):
        target = self.get_target()
        if not target:
            return
        is_pool = self.current_mode == POOLS
        cmd = ["zpool" if is_pool else "zfs", "get", "all", target]
        out, err, rc = run_cmd(cmd)
        if rc != 0:
            self.error_dialog(err)
            return
        self.show_properties_dialog(out, f"Properties: {target}", target, is_pool)

    def do_create_pool(self):
        self.pool_create_dialog()

    def do_import_pool(self):
        out, err, rc = run_cmd(["zpool", "import"])
        if rc != 0:
            self.error_dialog(err or "No pools available to import")
            return
        pools = [l.strip() for l in out.splitlines() if l.strip() and not l.startswith("pool:") and not l.startswith(" ")]
        pool_names = []
        for line in out.splitlines():
            m = re.search(r'^\s*pool:\s+(.+)$', line)
            if m:
                pool_names.append(m.group(1).strip())
        if not pool_names:
            self.message_dialog("No pools available to import.")
            return
        choices = "\n".join(f"{i+1}. {n}" for i, n in enumerate(pool_names))
        idx = self.input_dialog("Import Pool", f"Enter pool name to import:\n{choices}", pool_names[0])
        if idx and idx in pool_names:
            self.run_zfs_cmd(["zpool", "import", idx])
        elif idx:
            self.run_zfs_cmd(["zpool", "import", idx])

    def do_export_pool(self):
        target = self.get_target()
        if not target:
            return
        if self.confirm_dialog("Export Pool", f"Export pool {target}? It will no longer be available until imported again."):
            self.run_zfs_cmd(["zpool", "export", target])

    def do_scrub(self):
        target = self.get_target()
        if not target:
            return
        if self.confirm_dialog("Scrub Pool", f"Start scrub on {target}?"):
            def scrub_thread():
                out, err, rc = run_cmd(["zpool", "scrub", target])
                GLib.idle_add(self.on_scrub_done, rc, err)
            Thread(target=scrub_thread, daemon=True).start()
            self.message_dialog(f"Scrub started on {target}. Check Status to see progress.")

    def on_scrub_done(self, rc, err):
        if rc != 0:
            self.error_dialog(f"Scrub error:\n{err}")
        else:
            self.message_dialog("Scrub completed.")
        self.refresh_list()

    def do_status(self):
        target = self.get_target()
        if not target:
            return
        out, err, rc = run_cmd(["zpool", "status", target])
        if rc != 0:
            self.error_dialog(err)
            return
        self.show_text_dialog(out, f"Status: {target}")

    def do_upgrade(self):
        target = self.get_target()
        if not target:
            return
        if self.confirm_dialog("Upgrade Pool", f"Upgrade pool {target} to latest ZFS feature flags?"):
            self.run_zfs_cmd(["zpool", "upgrade", target])

    def do_zpool_label(self):
        target = self.get_target()
        if not target:
            return
        if self.confirm_dialog("Label Disk", f"Wipe filesystem and label /dev/{target} for ZFS?\nThis will destroy all data on the disk."):
            rc1, rc2 = 0, 0
            out1, err1, rc1 = run_cmd(["wipefs", "-a", f"/dev/{target}"])
            if rc1 == 0:
                out2, err2, rc2 = run_cmd(["zpool", "labelclear", f"/dev/{target}"])
            if rc1 == 0:
                self.message_dialog(f"Disk /dev/{target} cleared and ready for ZFS.")
            else:
                self.error_dialog(f"Failed to clear disk: {err1}")
            self.refresh_list()

