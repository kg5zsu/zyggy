    DISKS: ["name", "size", "type", "fstype", "model", "mountpoint"],
}

def has_zfs():
    p = Popen(["which", "zfs"], stdout=PIPE, stderr=PIPE)
    out, _ = p.communicate()
    return out != b''

def run_cmd(cmd):
    try:
        p = Popen(elevated_cmd(cmd), stdout=PIPE, stderr=PIPE)
        out, err = p.communicate()
        return out.decode('utf-8').strip(), err.decode('utf-8').strip(), p.returncode
    except Exception as e:
        return "", str(e), -1

def get_zfs_list(mode):
    if mode == DISKS:
        out, err, rc = run_cmd(["lsblk", "-o", "NAME,SIZE,TYPE,FSTYPE,MODEL,MOUNTPOINT", "-J", "-d"])
        if rc != 0 or not out:
            return [], ["name", "size", "type", "fstype", "model", "mountpoint"]
        data = json.loads(out)
        devices = data.get("blockdevices", [])
        rows = []
        for d in devices:
            rows.append([
                d.get("name", ""),
                d.get("size", ""),
                d.get("type", ""),
                d.get("fstype", "") if d.get("fstype") else "",
                d.get("model", "") if d.get("model") else "",
                d.get("mountpoint", "") if d.get("mountpoint") else "",
            ])
        return rows, ["name", "size", "type", "fstype", "model", "mountpoint"]

    cols = ",".join(ZFS_LIST_COLS[mode])
    zfs_type = {DATASETS: "filesystem", SNAPSHOTS: "snapshot", VOLUMES: "volume"}.get(mode, "filesystem")
    cmd = ["zfs", "list", "-o", cols, "-t", zfs_type] if mode in (DATASETS, SNAPSHOTS, VOLUMES) else ["zpool", "list", "-o", cols]

    out, err, rc = run_cmd(cmd)
    if rc != 0:
        if "no datasets" in err or "no pools" in err:
            return [], ZFS_LIST_COLS[mode]
        return None, err

    lines = out.splitlines()
    if len(lines) < 2:
        return [], ZFS_LIST_COLS[mode]
    header = lines[0].lower().split()
    rows = [re.split(r'\s+', l, maxsplit=len(header)-1) for l in lines[1:]]
    return rows, header

def get_system_disk():
    out, _, rc = run_cmd(["findmnt", "-n", "-o", "SOURCE", "/"])
    if rc != 0 or not out:
        return None
    dev = out.strip()
    parent, _, rc2 = run_cmd(["lsblk", "-n", "-o", "PKNAME", dev])
    if rc2 == 0 and parent:
        return parent.strip()
    return None

def get_pool_disks(pool):
    out, err, rc = run_cmd(["zpool", "status", "-P", pool])
    if rc != 0:
        return []
    seen = set()
    disks = []
    for line in out.splitlines():
        m = re.search(r'/dev/([a-z]+[a-z0-9]*(?:_[a-z0-9]+)?)', line)
        if m:
            d = re.sub(r'(p?\d+)$', '', m.group(1))
            if d not in seen and d != pool:
                seen.add(d)
                disks.append(d)
    return disks

def get_available_disks():
    out, err, rc = run_cmd(["lsblk", "-o", "NAME,SIZE,TYPE,FSTYPE,MODEL", "-J", "-d"])
    if rc != 0 or not out:
        return []
    data = json.loads(out)
    disks = [d for d in data.get("blockdevices", []) if d.get("type") == "disk"]
    sys_disk = get_system_disk()
    for d in disks:
        d["is_system"] = d.get("name") == sys_disk
    return disks


class ModePage:
    def __init__(self, app, mode):
        self.app = app
        self.mode = mode
        self.liststore = Gtk.ListStore()
        self.treeview = Gtk.TreeView()
        sel = self.treeview.get_selection()
        sel.set_mode(Gtk.SelectionMode.SINGLE)
        sel.connect("changed", lambda s: app.on_selection_changed())

        self.status_label = Gtk.Label()
        self.status_label.set_xalign(0)
        self.toolbar_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
        self.build_page()

    def build_page(self):
        scrolled = Gtk.ScrolledWindow()
        scrolled.set_vexpand(True)
        scrolled.add(self.treeview)

        self.empty_state = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        self.empty_state.set_valign(Gtk.Align.CENTER)
        self.empty_state.set_halign(Gtk.Align.CENTER)
        if self.mode == POOLS:
            lbl = Gtk.Label()
            lbl.set_markup("<b>No pools found</b>")
            self.empty_state.pack_start(lbl, False, False, 0)
            hint = Gtk.Label(label="Import an existing pool or create a new one:")
            self.empty_state.pack_start(hint, False, False, 0)
            btn_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            import_btn = Gtk.Button.new_with_label("Import Pool")
            import_btn.connect("clicked", lambda b: self.app.handle_action("import_pool"))
            btn_box.pack_start(import_btn, False, False, 0)
            create_btn = Gtk.Button.new_with_label("Create Pool")
            create_btn.connect("clicked", lambda b: self.app.handle_action("create_pool"))
            btn_box.pack_start(create_btn, False, False, 0)
            self.empty_state.pack_start(btn_box, False, False, 0)
            self.empty_state.show_all()
            self.empty_state.set_visible(False)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        box.pack_start(self.toolbar_box, False, False, 0)
        box.pack_start(scrolled, True, True, 0)
        box.pack_start(self.empty_state, True, True, 0)
        box.pack_start(self.status_label, False, False, 0)
        self.widget = box

    def set_columns(self, columns):
        for col in self.treeview.get_columns():
            self.treeview.remove_column(col)

        self.liststore = Gtk.ListStore()
        self.liststore.set_column_types([str] * len(columns))
        self.treeview.set_model(self.liststore)

        for i, title in enumerate(columns):
            renderer = Gtk.CellRendererText()
            col = Gtk.TreeViewColumn(title.upper(), renderer, text=i)
            col.set_resizable(True)
            self.treeview.append_column(col)

    def populate(self, rows):
        self.liststore.clear()
        for row in rows:
            self.liststore.append(row)
        has_empty_state = len(self.empty_state.get_children()) > 0
        if has_empty_state:
            self.treeview.set_visible(len(rows) > 0)
            self.empty_state.set_visible(len(rows) == 0)
        self.status_label.set_text(f"{len(rows)} {MODE_LABELS[self.mode].lower()}")

    def get_selected(self):
        sel = self.treeview.get_selection()
        m, it = sel.get_selected()
        if it is not None:
            return m[it][0]
        return None


