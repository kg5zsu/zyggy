IS_ROOT = os.geteuid() == 0
ZFS_CMDS = {"zfs", "zpool", "smartctl"}

def elevated_cmd(cmd):
    if IS_ROOT:
        return cmd
    if cmd and os.path.basename(cmd[0]) in ZFS_CMDS:
        return ["pkexec"] + cmd
    return cmd

