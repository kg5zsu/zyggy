    def on_prop_toggled(self, renderer, path, store, target, is_pool):
        prop = store[path][0]
        new_val = "off" if store[path][1] == "on" else "on"
        cmd = ["zpool" if is_pool else "zfs", "set", f"{prop}={new_val}", target]
        out, err, rc = run_cmd(cmd)
        if rc != 0:
            self.error_dialog(f"Failed to set {prop}={new_val}:\n{err}")
        else:
            store[path][1] = new_val
            renderer.set_active(new_val == "on")

    def on_property_edited(self, renderer, path, new_value, store, target, is_pool):
        prop = store[path][0]
        old_value = store[path][1]
        if new_value == old_value:
            return
        cmd = ["zpool" if is_pool else "zfs", "set", f"{prop}={new_value}", target]
        out, err, rc = run_cmd(cmd)
        if rc != 0:
            self.error_dialog(f"Failed to set {prop}={new_value}:\n{err}")
        else:
            store[path][1] = new_value

